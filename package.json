{
  "name": "three-sog-splats",
  "version": "0.1.0",
  "description": "Native SOG v2 Gaussian splat loading and rendering for Three.js",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:example": "vite build --config examples/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:r184": "node scripts/test-browser-compat.mjs 0.184.0",
    "test:package": "node scripts/test-package.mjs 0.184.0 && node scripts/test-package.mjs 0.185.0",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "generate:5m": "node scripts/generate-five-million-fixture.mjs",
    "test:acceptance": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:example && npm run test:browser && npm run test:browser:r184 && npm run test:package",
    "example": "vite --config examples/vite.config.ts",
    "prepack": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run test:acceptance",
    "fixtures:verify": "node scripts/fetch-fixtures.mjs --verify",
    "fixtures:fetch": "node scripts/fetch-fixtures.mjs",
    "test:browser:required": "SOG_REQUIRE_WEBGPU=1 playwright test",
    "benchmark:release": "npm run build:example && node scripts/benchmark-release.mjs"
  },
  "keywords": [
    "three.js",
    "gaussian-splatting",
    "sog",
    "webgpu"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.184.0 <0.186.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/three": "0.186.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "three": "0.186.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gqfx/three-sog-splats.git"
  },
  "bugs": {
    "url": "https://github.com/gqfx/three-sog-splats/issues"
  },
  "homepage": "https://github.com/gqfx/three-sog-splats#readme",
  "engines": {
    "node": ">=22.12.0"
  }
}

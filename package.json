{
  "name": "three-sog-splats",
  "version": "0.1.0",
  "description": "Native SOG v2 Gaussian splat loading and rendering for Three.js",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:example": "vite build --config examples/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:package": "node scripts/test-package.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "generate:5m": "node scripts/generate-five-million-fixture.mjs",
    "test:acceptance": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:example && npm run test:browser && npm run test:package",
    "example": "vite --config examples/vite.config.ts"
  },
  "keywords": [
    "three.js",
    "gaussian-splatting",
    "sog",
    "webgpu"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.184.0 <0.186.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.1",
    "@types/three": "0.185.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "three": "0.185.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
